{
  "name": "@wecom/model",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prompts",
    "eval/cases"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "//pretest": "This package resolves @wecom/shared through its built dist, so a schema this package's tests depend on is invisible until shared is rebuilt. `pnpm -r test` builds first; a bare `pnpm --filter @wecom/model test` did not, and failed with errors that looked like this package's fault.",
    "pretest": "pnpm --filter @wecom/shared build",
    "pretypecheck": "pnpm --filter @wecom/shared build",
    "preeval": "pnpm --filter @wecom/shared build",
    "test": "vitest run",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@wecom/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "tsx": "^4.19.2"
  }
}
