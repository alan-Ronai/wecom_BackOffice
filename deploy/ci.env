NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://kb:ci@db:5432/kb
SESSION_SECRET=ci-secret-ci-secret-ci-secret-1234
PUBLIC_URL=https://localhost:8443
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
AUTH_FALLBACK=none
PALOALTO_HOST=
PALOALTO_API_KEY=
PALOALTO_SUBNETS=
MODEL_URL=http://ollama:11434
# The smallest tag in the production model's family (~0.4 GB vs ~2 GB). CI pulls it for real so
# the smoke test can assert `modelStatus.tagPresent`; nothing in the smoke test runs inference.
MODEL_NAME=qwen2.5:0.5b-instruct-q4_K_M
# W-3: a *second* tag, deliberately different from MODEL_NAME, so this job proves the thing that
# was broken — that `ollama-pull` fetches EMBED_MODEL as well and `deploy/smoke.sh` refuses to pass
# when it is missing. With one tag configured for both, neither could ever have been observed.
#
# `all-minilm` (~46 MB) is chosen for size: this stack pulls it for real, and the assertion under
# test is "the tag is in `ollama list`", which is indifferent to what the model computes. It is a
# 384-dimensional model and `documents.embedding` is `vector(768)` (migration 0003), so
# `updateEmbedding` stores nothing here and swallows the mismatch exactly as it swallows an
# unreachable model — the same state this stack was already in. Production keeps
# `nomic-embed-text` (768) in deploy/.env.example; nothing in this job embeds a document.
EMBED_MODEL=all-minilm:latest
# Not a real secret — CI-only, non-default so ConfigSchema's production guard passes.
CONNECTOR_KEY=85ae2b16a6a0e4c65705baf6806f86e1e5a935a16ff127c337053b84f0256825
# Both are required when NODE_ENV=production (see ConfigSchema). The compose stubs a connector
# could be pointed at are named rather than covered by `*`: `wp` (the WordPress stub added by
# docker-compose.e2e.yml) and `paloalto` (the firewall stub the identity probes reach), plus
# loopback for anything running inside the api container. `*` would not admit them — it means
# "any public host" and refuses loopback and private ranges — and naming them also proves the
# allowlist admits what it is told to, which `*` would hide. A real install names its own.
CONNECTOR_HOST_ALLOWLIST=wp,paloalto,localhost,127.0.0.1
TRUST_PROXY=true
# One proxy (nginx) and no further: see deploy/.env.example.
TRUST_PROXY_HOPS=1
TRASH_DAYS=30
BACKUP_DIR=/backups
MIGRATE_ON_START=true
POSTGRES_PASSWORD=ci
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
BACKUP_RETENTION_DAYS=14
# Host-IP-qualified: the base compose file expands these to `127.0.0.1:8443:443` etc., so the
# CI/e2e stack answers on loopback only (see docker-compose.ci.yml).
WEB_HTTPS_PORT=127.0.0.1:8443
WEB_HTTP_PORT=127.0.0.1:8080
