# ── api (every ConfigSchema key; apps/api/test/env-example.test.ts fails if one is missing) ──
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://kb:change-me@db:5432/kb
# Required in production — the dev default is rejected at start-up. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-32-random-chars-minimum
PUBLIC_URL=https://kb.wecom.local
# Required in production — the API refuses to start without it. req.ip behind the nginx
# reverse proxy: true | false | comma-separated trusted proxy addresses/CIDRs. Keep it as
# the docker bridge CIDR so a client that reaches the API directly cannot forge
# X-Forwarded-For. req.ip gates PALOALTO_SUBNETS, the auth rate limits and the audit log.
TRUST_PROXY=172.16.0.0/12

# ── identity ────────────────────────────────────────────────────────────
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://kb.wecom.local/api/v1/auth/callback
# Microsoft Graph base URL — leave blank for the global cloud. Set it only for a national cloud
# (e.g. https://graph.microsoft.us). Used by the nightly identity sync and the admin group search.
# OIDC_GRAPH_URL=
AUTH_FALLBACK=none
PALOALTO_HOST=
PALOALTO_API_KEY=
PALOALTO_SUBNETS=10.0.0.0/8
# https in production; http only exists so the test suite can run a local stub firewall.
PALOALTO_SCHEME=https

# ── model (CPU-only inference) ───────────────────────────────────────────
MODEL_URL=http://ollama:11434
MODEL_NAME=qwen2.5:3b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
# true | false (only these two spellings; anything else is a start-up error).
# true falls back to the deterministic rule-based model — no Ollama call at all.
MODEL_DISABLED=false

# ── sources / connectors ────────────────────────────────────────────────
# Watched folder: every settled .docx in it is imported as a source every 2 minutes.
# Mounted as the `watch` volume on the api service; leave empty to disable.
WATCH_DIR=/data/watch
# Required in production — the all-zero default is rejected at start-up. AES-256-GCM key
# for connector configs at rest (WordPress application password, webhook secret).
# Generate once with `openssl rand -hex 32` and keep it with the database backups:
# rotating it makes existing connectors unreadable.
CONNECTOR_KEY=
# A `json` connector may only read files under this directory.
CONNECTOR_FILE_ROOT=/data/connectors
# Required in production — the API refuses to start with this empty. Comma-separated host
# allowlist for outbound connector HTTP (a WordPress baseUrl). Name the connector hosts you
# actually use, e.g. `wp.wecom.local,.wecom.local`; an entry starting with `.` matches any
# subdomain. Link-local/metadata addresses are refused unconditionally, everything else is
# governed by this list — it is what stops a connector becoming an SSRF primitive. Write `*`
# if you really mean "any public host"; it must be a deliberate choice, not a blank line.
CONNECTOR_HOST_ALLOWLIST=
# Whether an incoming webhook must carry the `X-KB-Nonce` header (see docs/connectors.md).
# Replay protection does not depend on this — the API remembers a hash of every signed body it
# accepts and answers 409 REPLAY to the second delivery either way. Leave it false for one
# release while WordPress plugins older than the header are still installed; each such delivery
# logs a deprecation warning. Set it true once every site is updated, so a stale plugin fails
# loudly rather than quietly.
WEBHOOK_REQUIRE_NONCE=false

# ── retention ───────────────────────────────────────────────────────────
BACKUP_DIR=/backups
TRASH_DAYS=30

# ── compose only ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
BACKUP_RETENTION_DAYS=14
WEB_HTTPS_PORT=443
WEB_HTTP_PORT=80
MIGRATE_ON_START=true
