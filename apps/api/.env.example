NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://kb:kb@localhost:5432/kb
# Signs the session and OIDC handshake cookies. At least 16 characters; rotate per environment.
SESSION_SECRET=dev-secret-change-me-please
# Origin of the web app. Also the base the OIDC callback redirects back to.
PUBLIC_URL=http://localhost:5173

# --- Entra ID (Microsoft) sign-in. All four must be set or /auth/login answers 503 PROVIDER_UNAVAILABLE.
# Tenant issuer, e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
# Application (client) id of the Entra app registration
OIDC_CLIENT_ID=
# Client secret of that app registration
OIDC_CLIENT_SECRET=
# Must match the redirect URI registered in Entra: https://<host>/api/v1/auth/callback
OIDC_REDIRECT_URI=

# --- Palo Alto User-ID fallback (LAN single sign-on). 'none' disables it entirely.
AUTH_FALLBACK=none
# host[:port] of the firewall's XML API
PALOALTO_HOST=
# XML API key (type=keygen)
PALOALTO_API_KEY=
# Comma-separated CIDRs whose client IPs may be identified through the firewall
PALOALTO_SUBNETS=
# Scheme used to reach PALOALTO_HOST. Keep https outside tests.
PALOALTO_SCHEME=https

MODEL_URL=http://localhost:11434
MODEL_NAME=qwen2.5:3b-instruct-q4_K_M

BACKUP_DIR=/backups
