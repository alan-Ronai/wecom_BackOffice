{
  "name": "@wecom/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "convert:legacy": "node seed/convert-legacy.mjs",
    "create-admin": "tsx src/cli/create-admin.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "node-pg-migrate -m migrations -j js --ignore-pattern package.json up",
    "migrate:down": "node-pg-migrate -m migrations -j js --ignore-pattern package.json down",
    "openapi": "tsx src/openapi.ts",
    "seed": "tsx src/seed.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:int": "RUN_INTEGRATION=1 vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.1.0",
    "@wecom/connectors": "workspace:*",
    "@wecom/model": "workspace:*",
    "@wecom/shared": "workspace:*",
    "argon2": "^0.41.1",
    "fast-xml-parser": "^4.5.7",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.1",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "node-pg-migrate": "^7.6.1",
    "openid-client": "^6.8.8",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.1",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "form-data": "^4.0.6",
    "oauth2-mock-server": "^7.2.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
